{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PixelForge External Asset Passport v1",
  "type": "object",
  "required": [
    "schema",
    "record_id",
    "asset_name",
    "primary_category",
    "license_status",
    "compatibility_state",
    "lane_verdict",
    "pixelforge_lane",
    "forge_targets",
    "source_storage",
    "source_redistribution_allowed",
    "qualified_for_use"
  ],
  "properties": {
    "schema": { "const": "pixelforge.external-asset-passport.v1" },
    "record_id": { "type": "string", "pattern": "^ASSET-[0-9]{6}$" },
    "source_inventory_id": { "type": ["integer", "null"], "minimum": 1 },
    "asset_name": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string" },
    "primary_category": { "type": "string", "minLength": 1 },
    "style": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "gameplay_role": { "type": "string" },
    "project_matches": { "type": "array", "items": { "type": "string" } },
    "suggested_priority": {},
    "license_status": { "type": "string" },
    "install_status": { "type": "string" },
    "audit_status": { "type": "string" },
    "compatibility_state": { "type": "string" },
    "lane_verdict": { "type": "string" },
    "source_kind": { "type": "string" },
    "source_record_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pixelforge_lane": { "enum": ["PORTABLE", "BAKEABLE", "REIMPLEMENT"] },
    "forge_targets": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "source_storage": { "const": "LOCAL_ONLY" },
    "source_redistribution_allowed": { "const": false },
    "qualified_for_use": { "type": "boolean" },
    "qualification_boundary": { "type": "string" }
  },
  "additionalProperties": false
}
